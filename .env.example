# Copy to .env at the repo root and fill it in. Load it from code/ before a run:  set -a; . ../.env; set +a
# Never commit .env.

# Image and video generation through OpenRouter (starts/gen.mjs, shots/vid.mjs, shots/profile/gen.mjs).
OPENROUTER_API_KEY=
# The public HTTPS folder where you upload <shot>/src-720.mp4 and <shot>/src-720-slow.mp4 from setup/spans.py.
# The video model fetches the spans itself, so they need a public HTTPS host, such as an R2 or S3 bucket with public reads.
SOURCE_BASE_URL=

# Tools.
# The unpacked rife-ncnn-vulkan release folder, relative to code/ (holds rife-ncnn-vulkan and rife-v4.6/).
# The release zip unpacks to a name like rife-ncnn-vulkan-20221029-macos, so rename it or point this at it.
RIFE_DIR=rife-ncnn-vulkan
# Read by the modal CLI itself. Leave it commented out to use your default profile.
# MODAL_PROFILE=
# Google Chrome for the newspaper render. The default is the macOS install path.
# CHROME_BIN=
# Folder with Inter, Inter Display, Barlow, Barlow Condensed and UnifrakturMaguntia (setup/fonts.sh fills it).
FONT_DIR=fonts

# Per-run switches. Each script's header says what it does with them. Leave them commented out normally,
# because an empty value overrides the default.
# Read by starts/gen.mjs, shots/profile/gen.mjs.
# OUT=
# MODEL=
# SIZE=
# QUALITY=
# DEBUG=
# Read by shots/newspaper/render.mjs.
# ONLY_FRAMES=
# FPS=
# CELEBRATE=
# OVERVIEW=
# Read by shots/film/film.py, shots/fastcuts/lab/splice.sh.
# BASE=
# MIX=
# Read by shots/opener/build.py.
# OPENER_BASE=
# OPENER_OUT=
# Read by shots/jersey/post.sh.
# TAKE=
# TAG=
